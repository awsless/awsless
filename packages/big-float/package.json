{
	"name": "@awsless/big-float",
	"version": "0.1.7",
	"description": "A tree-shakable, library for arbitrary-precision decimal arithmetic.",
	"keywords": [
		"arbitrary",
		"arithmetic",
		"bigfloat",
		"bigint",
		"bignumber",
		"precision"
	],
	"bugs": {
		"url": "https://github.com/awsless/awsless/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/awsless/awsless.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"require": "./dist/index.js",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"test": "pnpm vitest run -c ../../vitest.shared.ts",
		"build": "pnpm tsdown --no-fixed-extension src/index.ts --format esm --dts --clean",
		"prepublish": "if pnpm test; then pnpm build; else exit; fi"
	}
}
