{
	"name": "@awsless/validate",
	"version": "0.2.0",
	"bugs": {
		"url": "https://github.com/awsless/awsless/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/awsless/awsless.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"require": "./dist/index.cjs",
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"scripts": {
		"test": "pnpm vitest run -c ../../vitest.shared.ts",
		"build": "pnpm tsdown --no-fixed-extension src/index.ts --format cjs,esm --dts --clean",
		"prepublish": "if pnpm test; then pnpm build; else exit; fi"
	},
	"dependencies": {
		"valibot": "1.4.2"
	},
	"devDependencies": {
		"@awsless/big-float": "workspace:^",
		"@awsless/duration": "workspace:^",
		"@awsless/dynamodb": "workspace:^",
		"@awsless/json": "workspace:^"
	},
	"peerDependencies": {
		"@awsless/big-float": "workspace:^",
		"@awsless/duration": "workspace:^",
		"@awsless/dynamodb": "workspace:^",
		"@awsless/json": "workspace:^"
	}
}
