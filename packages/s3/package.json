{
	"name": "@awsless/s3",
	"version": "0.0.22",
	"bugs": {
		"url": "https://github.com/awsless/awsless/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/awsless/awsless.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"require": "./dist/index.cjs",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"test": "pnpm vitest run -c ../../vitest.shared.ts",
		"build": "pnpm tsdown --no-fixed-extension src/index.ts --format cjs,esm --dts --clean",
		"prepublish": "if pnpm test; then pnpm build; else exit; fi"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "3.1113.0",
		"@aws-sdk/s3-presigned-post": "3.1113.0",
		"@aws-sdk/s3-request-presigner": "3.1113.0",
		"@awsless/duration": "workspace:^",
		"@awsless/size": "workspace:^",
		"@awsless/utils": "workspace:^",
		"@smithy/types": "4.17.2",
		"@smithy/util-stream": "4.8.2",
		"aws-sdk-client-mock": "4.1.0"
	},
	"devDependencies": {
		"@aws-sdk/types": "3.974.4"
	},
	"peerDependencies": {
		"vitest": "^4"
	},
	"peerDependenciesMeta": {
		"vitest": {
			"optional": true
		}
	}
}
