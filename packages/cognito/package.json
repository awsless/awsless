{
	"name": "@awsless/cognito",
	"version": "0.0.5",
	"description": "Lightweight AWS Cognito client for the browser.",
	"keywords": [
		"amazon",
		"auth",
		"aws",
		"cognito",
		"identity"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/awsless/awsless.git"
	},
	"type": "module",
	"main": "./src/index.js",
	"scripts": {
		"test": "pnpm vitest run -c ../../vitest.shared.ts",
		"build": "pnpm tsdown --no-fixed-extension src/index.ts --format cjs,esm --dts --clean",
		"prepublish": "if pnpm test; then pnpm build; else exit; fi"
	},
	"dependencies": {
		"@types/js-cookie": "3.0.6",
		"js-cookie": "3.0.8",
		"jwt-decode": "4.0.0"
	},
	"devDependencies": {
		"cognito-srp": "0.2.0"
	}
}
