{
	"name": "@awsless/redis",
	"version": "0.1.14",
	"bugs": {
		"url": "https://github.com/awsless/awsless/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/awsless/awsless.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"require": "./dist/index.cjs",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"test": "pnpm vitest run -c ../../vitest.shared.ts",
		"build": "pnpm tsdown --no-fixed-extension src/index.ts --format cjs,esm --dts --clean",
		"prepublish": "if pnpm test; then pnpm build; else exit; fi"
	},
	"dependencies": {
		"@awsless/big-float": "workspace:^",
		"@awsless/duration": "workspace:^",
		"@heat/request-port": "0.0.1",
		"@types/chunk": "0.0.2",
		"chunk": "0.0.3",
		"ioredis": "6.0.0",
		"redis-memory-server": "0.17.1"
	},
	"peerDependencies": {
		"@awsless/big-float": "workspace:^",
		"@awsless/duration": "workspace:^"
	}
}
