{
	"name": "@awsless/dynamodb-server",
	"version": "0.1.10",
	"bugs": {
		"url": "https://github.com/awsless/awsless/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/awsless/awsless.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"test": "bun test",
		"build": "pnpm tsdown --no-fixed-extension src/index.ts --format esm --dts --clean",
		"prepublish": "if bun test; then pnpm build; else exit; fi"
	},
	"dependencies": {
		"@aws-sdk/client-dynamodb": "3.1113.0",
		"@aws-sdk/lib-dynamodb": "3.1113.0",
		"@awsless/big-float": "workspace:^"
	},
	"devDependencies": {
		"@types/bun": "1.3.14",
		"bun-types": "1.3.14",
		"typescript": "7.0.2"
	},
	"optionalDependencies": {
		"dynamo-db-local": "11.0.0"
	}
}
