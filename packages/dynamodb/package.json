{
	"name": "@awsless/dynamodb",
	"version": "0.3.26",
	"keywords": [
		"AWS",
		"DynamoDB",
		"amazon",
		"builder",
		"dynamo",
		"query",
		"schema"
	],
	"bugs": {
		"url": "https://github.com/awsless/awsless/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/awsless/awsless.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"require": "./dist/index.cjs",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"test": "pnpm vitest run -c ../../vitest.shared.ts",
		"build": "pnpm tsdown --no-fixed-extension src/index.ts --format cjs,esm --dts --clean",
		"prepublish": "if pnpm test; then pnpm build; else exit; fi"
	},
	"dependencies": {
		"@aws-sdk/client-dynamodb": "3.1113.0",
		"@aws-sdk/lib-dynamodb": "3.1113.0",
		"@aws-sdk/util-dynamodb": "3.996.9",
		"@awsless/dynamodb-server": "workspace:^",
		"@awsless/json": "workspace:^",
		"@awsless/utils": "workspace:^",
		"@heat/request-port": "0.0.1",
		"@smithy/node-http-handler": "4.11.2",
		"aws-sdk-vitest-mock": "1.0.98",
		"chunk": "0.0.3"
	},
	"devDependencies": {
		"@awsless/big-float": "workspace:^",
		"@smithy/types": "4.17.2",
		"@types/chunk": "0.0.2"
	},
	"peerDependencies": {
		"@awsless/big-float": "workspace:^",
		"@awsless/json": "workspace:^",
		"vitest": ">=4"
	},
	"peerDependenciesMeta": {
		"vitest": {
			"optional": true
		}
	},
	"vitest": {
		"hookTimeout": 30000,
		"exclude": [
			"test/aws/*",
			"**/__*/**"
		]
	}
}
