{
	"$schema": "../../dist/app.json",
	"name": "app-kennedy",
	"region": "us-east-1",
	"profile": "jacksclub",
	"defaults": {
		"function": {
			"log": {
				"retention": "7 days",
				"level": "error",
				"system": "warn"
			}
		},
		"onFailure": "./on-failure/handle.ts",
		"onErrorLog": "./on-error-log/consumer.ts"
	}
}
