{
	"$schema": "../../dist/app.json",
	"name": "app-kennedy",
	"region": "us-east-1",
	"profile": "jacksclub",
	"defaults": {
		"topics": ["events"],
		"domains": {
			"main": {
				"domain": "awsless.org"
			}
		},
		"router": {
			"main": {
				"domain": "main",
				"subDomain": "www"
			},
			"apex": {
				"domain": "main"
			},
			"sub": {
				"domain": "main",
				"subDomain": "subdomain"
			}
		},
		"rpc": {
			"api": {
				"router": "main",
				"path": "/rpc"
			}
		},
		"pubsub": {
			"test": {
				"router": "main",
				"auth": "./pubsub/auth.ts"
			}
		},
		"function": {
			"log": {
				"retention": "7 days",
				"level": "error",
				"system": "warn"
			}
		},
		"instance": {
			"cpu": 0.25,
			"memorySize": "512 MB",
			"healthCheck": {
				"path": "/",
				"interval": "10 seconds",
				"timeout": "5 seconds",
				"retries": 3,
				"startPeriod": "30 second"
			},
			"log": {
				"retention": "1 week"
			}
		},
		"onFailure": "./on-failure/handle.ts",
		"onErrorLog": "./on-error-log/consumer.ts"
		// "layers": {
		// 	"test": {
		// 		"file": "./layer/2.zip",
		// 		"architecture": "x86_64"
		// 	}
		// }
	}
}
