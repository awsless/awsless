{
	"$schema": "../../dist/stack.json",
	"name": "stack",
	"tests": false,
	"functions": {
		"function": "./function/index.ts",
		"standalone": {
			"code": "./function/index.ts",
			"memorySize": "256 MB",
			"timeout": "30 seconds"
		},
		"standalone-caller": {
			"code": "./function/standalone-caller.ts",
			"memorySize": "256 MB"
		},
		"sandboxed": {
			"code": "./function/sandboxed.ts",
			"sandbox": ["stack:function:function", "stack:task:work"]
		},
		"caller": "./function/caller.ts"
	},
	"crons": {
		"tick": {
			"consumer": "./function/cron.ts",
			"schedule": "1 minute",
			"payload": { "source": "cron" }
		}
	},
	"queues": {
		"jobs": {
			"consumer": "./function/queue.ts",
			"retentionPeriod": "1 hour"
		}
	},
	"tasks": {
		"work": "./function/task.ts"
	},
	"tables": {
		"logs": {
			"hash": "hash",
			"fields": {
				"updatedAt": "number"
			},
			"indexes": {
				"log-level": {
					"hash": "logLevel",
					"sort": "updatedAt"
				},
				"origin": {
					"hash": "origin",
					"sort": "updatedAt"
				}
			}
		}
	}
}
