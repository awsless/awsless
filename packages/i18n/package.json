{
	"name": "@awsless/i18n",
	"version": "0.0.18",
	"keywords": [
		"ai",
		"i18n",
		"internationalization",
		"plugin",
		"svelte",
		"sveltekit",
		"vite"
	],
	"bugs": {
		"url": "https://github.com/awsless/awsless/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/awsless/awsless.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./svelte": {
			"svelte": "./dist/svelte-5.svelte.js",
			"types": "./dist/svelte-5.svelte.d.ts"
		}
	},
	"scripts": {
		"test": "pnpm vitest run -c ../../vitest.shared.ts",
		"build": "pnpm tsdown --no-fixed-extension src/index.ts --format esm --dts --clean",
		"build-svelte": "pnpm tsdown --no-fixed-extension --no-clean src/framework/svelte-5.svelte.ts --format esm --dts",
		"prepublish": "if pnpm test; then pnpm build; pnpm build-svelte; else exit; fi"
	},
	"dependencies": {
		"@swc/core": "1.16.1",
		"@types/chunk": "0.0.2",
		"@types/line-column": "1.0.2",
		"ai": "7.0.68",
		"chunk": "0.0.3",
		"estree-walker": "3.0.3",
		"glob": "13.0.6",
		"line-column": "1.0.2",
		"magic-string": "1.2.1",
		"swc-walk": "3.0.0-rc.0",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@ai-sdk/openai": "4.0.43",
		"@sveltejs/vite-plugin-svelte": "7.3.0",
		"svelte": "5.56.9",
		"svelte-preprocess": "6.0.5",
		"vite": "8.2.1"
	},
	"peerDependencies": {
		"svelte": "5.55.1",
		"vite": "7.3.1"
	},
	"vitest": {
		"exclude": [
			"test/_site"
		]
	}
}
