{
	"name": "@awsless/clui",
	"version": "0.0.10",
	"bugs": {
		"url": "https://github.com/awsless/awsless/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/awsless/awsless.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"require": "./dist/index.cjs",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"bug": "bun ./demo/bug.ts",
		"prompts": "bun ./demo/prompts.ts",
		"logs": "bun ./demo/logs.ts",
		"test": "pnpm vitest run -c ../../vitest.shared.ts",
		"build": "pnpm tsdown --no-fixed-extension src/index.ts --format cjs,esm --dts --clean",
		"prepublish": "if pnpm test; then pnpm build; else exit; fi"
	},
	"dependencies": {
		"@clack/prompts": "1.7.0",
		"ansi-truncate": "1.4.0",
		"chalk": "6.0.0",
		"cli-table3": "0.6.5",
		"string-length": "7.0.1",
		"wrap-ansi": "10.0.1"
	}
}
