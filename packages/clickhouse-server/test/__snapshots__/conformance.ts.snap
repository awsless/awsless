{"like('abc', '%b%')":1,"notLike('abc', 'a_')":1,"ilike('ABC', 'a%')":1,"like('a%b', 'a\\\\\\\\%b')":1,"concat('a', NULL)":null,"coalesce(NULL, 'x')":"x","ifNull(NULL, 1)":1,"nullIf(1, 1)":null,"toString(123)":"123","toUInt32('42')":42}

