{"replaceAll('a-b-c', '-', '+')":"a+b+c","replaceRegexpAll('a1b22c', '\\\\\\\\d+', '#')":"a#b#c","replaceRegexpOne('abc', '(b)', '[\\\\\\\\1]')":"a[b]c","extract('id=42&x', 'id=(\\\\\\\\d+)')":"42","match('abc', '^a.c$')":1,"splitByChar(',', 'a,b,,c')":["a","b","","c"],"arrayStringConcat(['a', 'b'], '-')":"a-b"}

