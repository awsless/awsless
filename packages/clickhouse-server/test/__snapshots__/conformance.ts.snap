{"projectId":"p2","visitorId":"v3","count()":2}

---
SELECT arrayJoin(flags) AS flag, count() AS c FROM events GROUP BY flag ORDER BY c DESC, flag
{"flag":"vpn","c":3}
{"flag":"datacenter","c":1}
{"flag":"tor","c":1}

---
SELECT projectId, id FROM events ORDER BY score DESC LIMIT 1 BY projectId
