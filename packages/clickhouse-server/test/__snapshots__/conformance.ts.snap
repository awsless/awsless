{"trimBoth('  x  ')":"x","trimLeft('  x')":"x","trimRight('x  ')":"x","reverse('abc')":"cba","repeat('ab', 3)":"ababab","leftPad('7', 3, '0')":"007","empty('')":1,"notEmpty('a')":1,"base64Encode('hi')":"aGk=","hex('A')":"41","lower(hex(MD5('a')))":"0cc175b9c0f1b6a831c399e269772661"}

