exports[`ClickHouse conformance > tables & inserts 1`] = `
"SELECT * FROM events ORDER BY id
{"id":"a","projectId":"p1","visitorId":"v1","externalId":"u1","flags":["vpn"],"score":3,"bot":"not_detected","country":"NL","createdAt":"2026-10-23 23:30:00.000"}
{"id":"b","projectId":"p1","visitorId":"v1","externalId":"u2","flags":[],"score":0,"bot":"good","country":"DE","createdAt":"2026-10-24 08:00:00.000"}
{"id":"c","projectId":"p1","visitorId":"v2","externalId":null,"flags":["tor","vpn"],"score":6.5,"bot":"bad","country":"NL","createdAt":"2026-10-24 09:15:30.250"}
{"id":"d","projectId":"p2","visitorId":"v3","externalId":"u1","flags":["vpn"],"score":1,"bot":"not_detected","country":"US","createdAt":"2026-10-25 03:46:40.000"}
{"id":"e","projectId":"p2","visitorId":"v3","externalId":null,"flags":["datacenter"],"score":2.25,"bot":"bad","country":"NL","createdAt":"2026-10-24 22:00:00.000"}

---
SELECT id, country, externalId FROM events WHERE externalId IS NULL ORDER BY id
{"id":"c","country":"NL","externalId":null}
{"id":"e","country":"NL","externalId":null}

---
SELECT id FROM events WHERE has(flags, 'vpn') AND score > 1 ORDER BY id
{"id":"a"}
{"id":"c"}

---
SELECT id FROM events WHERE createdAt >= '2026-10-24 00:00:00' AND createdAt < '2026-10-25' ORDER BY id
{"id":"b"}
{"id":"c"}
{"id":"e"}

---
SELECT id, bot FROM events WHERE bot IN ('bad', 'good') ORDER BY createdAt DESC LIMIT 2
{"id":"e","bot":"bad"}
{"id":"c","bot":"bad"}

---
SELECT id FROM events ORDER BY score DESC LIMIT 2 OFFSET 1
{"id":"a"}
{"id":"e"}

---
SELECT count() FROM events
{"count()":5}

---
SELECT id FROM events WHERE id IN (SELECT id FROM events WHERE country = 'NL') ORDER BY id
{"id":"a"}
{"id":"c"}
{"id":"e"}

---
SELECT id, (SELECT max(score) FROM events) AS top FROM events WHERE score = top
{"id":"c","top":6.5}
"
`;

