{"countIf(equals(bot, 'bad'))":2,"sumIf(score, has(flags, 'vpn'))":10.5,"uniqExact(visitorId)":3,"groupArray(id)":["a","b","c","e","d"],"groupUniqArray(projectId)":["p1","p2"],"any(projectId)":"p1","argMax(id, score)":"c","argMin(id, score)":"b"}

---
SELECT quantile(0.5)(score), quantiles(0.25, 0.75)(score), median(score), quantileExact(0.5)(score), topK(2)(projectId), count(DISTINCT visitorId), countDistinct(projectId) FROM events
{"quantile(0.5)(score)":2.25,"quantiles(0.25, 0.75)(score)":[1,3],"median(score)":2.25,"quantileExact(0.5)(score)":2.25,"topK(2)(projectId)":["p1","p2"],"countDistinct(visitorId)":3,"countDistinct(projectId)":2}

