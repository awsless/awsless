{"lower('AbC')":"abc","upper('abc')":"ABC","concat('a', 'b', 'c')":"abc","substring('hello', 2, 3)":"ell","substring('hello', -3)":"llo","startsWith('hello', 'he')":1,"endsWith('hello', 'lo')":1,"position('hello', 'l')":3}

