{
	"$schema": "../../dist/stack.json",
	"name": "stack",
	"tests": false,
	"tables": {
		"todos": {
			"hash": "id"
		}
	},
	"functions": {
		"list": "./todo/list.ts"
	},
	"rpc": {
		"api": {
			"listTodos": "./todo/list.ts",
			"addTodo": "./todo/add.ts",
			"toggleTodo": "./todo/toggle.ts",
			"removeTodo": "./todo/remove.ts"
		}
	},
	"sites": {
		"web": {
			"router": "main",
			"path": "/",
			"ssr": {
				"code": "./site/server.ts",
				"vpc": false,
				"sandbox": {
					"functions": ["stack:list"],
					"configs": ["greeting"]
				}
			}
		}
	}
}
