{
	"$schema": "../../dist/app.json",
	"name": "app-jack",
	"region": "us-east-1",
	"profile": "jacksclub",
	// "protect": true,
	//

	"configs": ["admin-secret", "max-tasks"],
	"seed": "./todo/seed.ts",
	"test": {
		"configs": {
			"admin-secret": "test-secret",
			"max-tasks": "10"
		}
	},

	"onFailure": "./on-failure.ts",
	"onErrorLog": "./on-error-log.ts",
	"domains": {
		"main": {
			"domain": "awsless.com"
		}
	},
	"router": {
		"main": {
			"domain": "main",
			"passwordAuth": {
				"password": "password",
				"sessionDuration": "temporary"
			}
		}
	},
	"rpc": {
		"main": {
			"router": "main",
			"path": "/api",
			"auth": "./rpc-auth.ts"
		}
	},
	"rest": {
		"hooks": {}
	},

	// Local dev binds against the REAL deployed user pools - an
	// undeployed app lists the pool as "not deployed".
	"auth": {
		"users": {
			"groups": ["admin", "support", "marketing"]
		}
	},

	// Alerts notify the team through email/sms in production - locally
	// they land on the dashboard's Alerts tab.
	"alerts": {
		"critical": "info@jacksclub.io"
	},
	"pubsub": {
		"main": {
			"router": "main",
			"path": "/ws",
			"auth": "./auth-pubsub.ts"
		}
	},
	"topics": ["task-created"],

	// // The app's one ClickHouse Cloud service, for the analytics stack. Small,
	// // and paused when idle, so an example app costs next to nothing.
	// "clickhouse": {
	// 	"memory": { "min": 8, "max": 8 },
	// 	"idleTimeout": "5 minutes"
	// },

	// The app's one Postgres database, for the billing stack. It scales to
	// nothing & pauses when idle, so an example app costs next to nothing.
	"postgres": {
		"memory": { "min": 0, "max": 2 },
		"idleTimeout": "10 minutes"
	},
	"function": {
		"log": {
			"retention": "1 days",
			"level": "trace"
		}
	}
}
