{
	"$schema": "../../dist/app.json",
	"name": "app-jack",
	"region": "us-east-1",
	"profile": "jacksclub",
	// "protect": true,
	//

	"configs": ["admin-secret", "max-tasks", "max-profit", "google-long-secret-key-for-testing", "google-another"],
	"seed": "./todo/seed.ts",
	"test": {
		"configs": {
			"admin-secret": "test-secret",
			"max-tasks": "10"
		}
	},

	"onFailure": "./on-failure.ts",
	"domains": {
		"main": {
			"domain": "awsless.com"
		}
	},
	"router": {
		"main": {
			"domain": "main"
		}
	},
	"rpc": {
		"main": {
			"router": "main",
			"path": "/api",
			"auth": "./rpc-auth.ts"
		}
	},
	"rest": {
		"hooks": {}
	},

	// Local dev binds against the REAL deployed user pools - an
	// undeployed app lists the pool as "not deployed".
	"auth": {
		"users": {
			"groups": ["admin", "support", "marketing"]
		}
	},

	// Alerts notify the team through email/sms in production - locally
	// they land on the dashboard's Alerts tab.
	"alerts": {
		"critical": "info@jacksclub.io"
	},
	"pubsub": {
		"main": {
			"router": "main",
			"path": "/ws",
			"auth": "./auth-pubsub.ts"
		}
	},
	"topics": ["task-created"],
	"function": {
		"log": {
			"retention": "1 days",
			"level": "trace"
		}
	}
}
