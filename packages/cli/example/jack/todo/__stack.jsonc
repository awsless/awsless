{
	"$schema": "../../../dist/stack.json",
	"name": "stack-2",
	// "tests": false,
	"tests": "./test-2",

	"queues": {
		"log": "./function.ts"
	},
	"crons": {
		"test": {
			"schedule": "1 day",
			"consumer": "./function.ts"
		}
	},
	"subscribers": {
		"login": "./function.ts"
	},
	"stores": {
		"store": {}
	},
	"caches": {
		"cache": {}
	},
	"pubsub": {
		"main": {
			"connected": "./function.ts"
		}
	},
	"rpc": {
		"main": {
			"test": "./function.ts"
		}
	},
	"routes": {
		"main": {
			"/test": "./function.ts"
		},
		"webhooks": {
			"/test": "./function.ts",
			"/google": "./function.ts"
		}
	},
	"images": {
		"main": {
			"router": "main",
			"path": "/images",
			"extensions": {
				"png": {}
			},
			"presets": {
				"lg": {
					"width": 200
				},
				"md": {
					"width": 100
				},
				"sm": {
					"width": 50
				}
			},
			"origin": {
				"static": "./image"
			}
		}
	},
	"icons": {
		"main": {
			"router": "main",
			"path": "/icons",
			"origin": {
				"static": "./icon"
			}
		}
	},
	"searchs": {
		"posts": {}
	},
	"tables": {
		"posts": {
			"hash": "id"
		}
	},
	"sites": {
		"public": {
			"router": "main",
			"path": "/",
			"static": "./site"
		}
	}
}
