{
	"name": "@awsless/open-search",
	"version": "0.0.34",
	"bugs": {
		"url": "https://github.com/awsless/awsless/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/awsless/awsless.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"require": "./dist/index.cjs",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"test": "pnpm vitest run -c ../../vitest.shared.ts",
		"build": "pnpm tsdown --no-fixed-extension src/index.ts --format cjs,esm --dts --clean",
		"prepublish": "if pnpm test; then pnpm build; else exit; fi"
	},
	"dependencies": {
		"@aws-sdk/credential-providers": "3.1113.0",
		"@awsless/big-float": "workspace:^",
		"@awsless/open-search-server": "workspace:^",
		"@heat/request-port": "0.0.1",
		"@opensearch-project/opensearch": "3.6.0"
	},
	"peerDependencies": {
		"@opensearch-project/opensearch": "3.6.0"
	}
}
