{
	"name": "@awsless/ecs",
	"version": "0.0.4",
	"bugs": {
		"url": "https://github.com/awsless/awsless/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/awsless/awsless.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"require": "./dist/index.cjs",
			"import": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test": "pnpm vitest run -c ../../vitest.shared.ts",
		"build": "pnpm tsdown --no-fixed-extension src/index.ts --format cjs,esm --dts --clean",
		"prepublish": "if pnpm test; then pnpm build; else exit; fi"
	},
	"dependencies": {
		"@aws-sdk/client-ecs": "3.1113.0",
		"@awsless/json": "workspace:^",
		"@awsless/utils": "workspace:^",
		"aws-sdk-vitest-mock": "1.0.98"
	},
	"devDependencies": {
		"vitest": "4.1.11"
	},
	"peerDependencies": {
		"vitest": "^4"
	},
	"peerDependenciesMeta": {
		"vitest": {
			"optional": true
		}
	}
}
