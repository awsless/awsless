{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"categories": {
		"correctness": "warn",
		"suspicious": "warn"
	},
	"rules": {
		"no-explicit-any": "off",
		"ban-ts-comment": "off",
		"no-empty-function": ["warn", { "allow": ["arrowFunctions", "methods", "asyncMethods"] }], // Used for mocks
		"no-thenable": "off", // The dynamodb & redis command objects are deliberately thenable - that's the whole lazy command api.
		"no-for-in-array": "off", // want able to use for .. in/of ..
		"no-useless-concat": "off", // The bigfloat tests split their long literals
		"no-unmodified-loop-condition": "off", // Abort signals mutate from outside the loop.
		"no-extraneous-class": "off", // A test needs an empty class to check instanceof
		"no-shadow": "off", // is used
		"no-new": "off", // Declaring a terraforge resource is the effect
		"no-underscore-dangle": "off", // Wire fields like __type, and enum_ for reserved words
		"consistent-return": "off", // Doesn't allow return, should be return undefined
		"consistent-function-scoping": "off", // Test helpers belong next to the cases they run
		"no-useless-spread": "off", // We copy a map before deleting from it while looping
		"no-unnecessary-type-assertion": "off", // Removing the casts it flags breaks the build
		"no-unsafe-type-assertion": "off", // We cast to narrow parsed strings all over the place
		"restrict-template-expressions": "off", // Test names print bigfloats & errors, which stringify fine
		"no-unnecessary-type-parameters": "off", // The caller picks the type, like peek<User>()
		"no-redundant-type-constituents": "off", // A plain string already covers Numeric's number strings
		"no-unused-vars": ["warn", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }], // A leading _ means we skip it on purpose
		"no-unused-expressions": "off" // The mocks guard their hooks with `beforeEach && beforeEach(...)`
	},
	"ignorePatterns": [
		"**/dist/**",
		"**/.awsless/**",
		"**/_*",
		"**/old/**",
		"packages/cli/example/**",
		"packages/cli/layers/**"
	]
}
