{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"categories": {
		"correctness": "warn",
		"suspicious": "warn"
	},
	"rules": {
		"no-explicit-any": "off",
		"ban-ts-comment": "off",

		// Used for mocks
		"no-empty-function": ["warn", { "allow": ["arrowFunctions", "methods", "asyncMethods"] }],

		// The dynamodb & redis command objects are deliberately thenable -
		// that's the whole lazy command api.
		"no-thenable": "off",

		// Style opinions this codebase deliberately doesn't follow.
		"no-for-in-array": "off", // want able to use for .. in/of ..
		"no-useless-concat": "off", // The bigfloat tests split their long literals
		"no-unmodified-loop-condition": "off", // Abort signals mutate from outside the loop.
		"no-extraneous-class": "off",
		"no-shadow": "off",
		"no-new": "off", // Declaring a terraforge resource is the effect
		"no-underscore-dangle": "off", // Wire fields like __type, and enum_ for reserved words
		"consistent-return": "off", // Doesn't allow return, should be return undefined
		"consistent-function-scoping": "off", // Test helpers belong next to the cases they run
		"prefer-add-event-listener": "off",
		"no-useless-spread": "off", // We copy a map before deleting from it while looping

		// Type-strictness noise: assertions & template stringification
		// are used deliberately all over the schema & config internals.
		// The unnecessary-assertion rule disagrees with tsc 7 about
		// which assertions are load-bearing, so it can't be trusted.
		"no-unnecessary-type-assertion": "off",
		"no-unsafe-type-assertion": "off",
		"restrict-template-expressions": "off",
		"no-unnecessary-type-parameters": "off", // The caller picks the type, like peek<User>()
		"no-redundant-type-constituents": "off", // A plain string already covers Numeric's number strings

		// The whole-repo tsc gate already reports unused code, and the
		// `beforeEach && beforeEach(...)` mock guards trip the
		// expression rule.
		"no-unused-vars": "off",
		"no-unused-expressions": "off"
	},
	"ignorePatterns": [
		"**/dist/**",
		"**/.awsless/**",
		"**/_*",
		"**/old/**",
		"packages/cli/example/**",
		"packages/cli/layers/**"
	]
}
