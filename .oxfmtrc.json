{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"printWidth": 120,
	"trailingComma": "es5",
	"arrowParens": "avoid",
	"bracketSpacing": true,
	"tabWidth": 4,
	"useTabs": true,
	"semi": false,
	"singleQuote": true,
	"singleAttributePerLine": false,
	"bracketSameLine": true,
	"jsxSingleQuote": true,
	"sortImports": {
		"newlinesBetween": false
	},
	"sortPackageJson": true,
	"overrides": [
		{
			"files": ["**/*.jsonc", "**/*.json5"],
			"options": {
				"trailingComma": "none"
			}
		}
	],
	"ignorePatterns": ["**/dist/**", "**/.awsless/**", "**/old/**", "pnpm-lock.yaml", "packages/cli/layers/**"]
}
