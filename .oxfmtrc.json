{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"printWidth": 120,
	"trailingComma": "es5",
	"arrowParens": "avoid",
	"bracketSpacing": true,
	"tabWidth": 4,
	"useTabs": true,
	"semi": false,
	"singleQuote": true,
	"singleAttributePerLine": false,
	"bracketSameLine": true,
	"jsxSingleQuote": true,
	"sortImports": true,
	"sortPackageJson": false,
	"ignorePatterns": [
		"**/dist/**",
		"**/.awsless/**",
		"old/**",
		"pnpm-lock.yaml",
		"packages/cli/layers/**",
		"packages/code/test/data/**"
	]
}
